{
  "<% code block": {
    "prefix": "<%",
    "body": ["<% $0 %>"],
    "description": "Guaraci Lua code block"
  },
  "<%= expression": {
    "prefix": "<%=",
    "body": ["<%= $0 %>"],
    "description": "Guaraci Lua expression"
  },
  "<% if block": {
    "prefix": "<%if",
    "body": ["<% if ${1:cond} then %>", "  $0", "<% end %>"],
    "description": "Guaraci if block"
  },
  "<% for block": {
    "prefix": "<%for",
    "body": ["<% for ${1:i}, ${2:item} in ipairs(${3:items}) do %>", "  $0", "<% end %>"],
    "description": "Guaraci for block"
  },
  "include helper": {
    "prefix": "inc",
    "body": ["<% include('${1:name}', ${2:{ }}) %>"],
    "description": "include(name, data) helper"
  },
  "partial helper": {
    "prefix": "partial",
    "body": ["<% partial('${1:name}', ${2:{ }}) %>"],
    "description": "partial(name, data) helper"
  }
}
